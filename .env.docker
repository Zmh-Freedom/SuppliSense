# ===== MongoDB =====
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=123456
MONGO_AUTH_SOURCE=admin
MONGO_DB=tianyancha

# ===== Redis =====
REDIS_URL=redis://redis:6379

# ===== JWT =====
SECRET_KEY=change-this-to-a-random-secret-in-production

# ===== Tianyancha =====
TIANYANCHA_TOKEN=
TIANYANCHA_BASE_URL=http://open.api.tianyancha.com

# ===== LLM =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Feishu =====
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# ===== Sentry =====
SENTRY_DSN=

# ===== CORS =====
CORS_ORIGINS=["http://localhost"]

# ===== Cron =====
ALERT_CHECK_CRON=0 9 * * *
ALERT_REFRESH_CRON=0 9 * * 1
FEISHU_DIGEST_CRON=0 9 * * *
SENTIMENT_CHECK_CRON=0 10 * * *
