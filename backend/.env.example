# 天眼查 API
TIANYANCHA_TOKEN=your_token_here
# TIANYANCHA_BASE_URL=http://open.api.tianyancha.com

# 免费巡检 cron（AkShare 财报），默认每天9点，不花钱
# ALERT_CHECK_CRON=0 9 * * *

# 付费刷新 cron（天眼查 API），默认每周一9点，花钱
# ALERT_REFRESH_CRON=0 9 * * 1

# LLM（DeepSeek / OpenAI 兼容）
LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# Agent 聊天运行时：所有只读请求统一使用 Harness Runtime；人工写操作由持久化审批入口处理。

# 飞书机器人 webhook（告警实时推送 + 每日简报）
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# FEISHU_SECRET=your_secret    # 签名校验密钥，未启用可不填
# FEISHU_DIGEST_CRON=0 9 * * *

# 飞书多维表格正式供应商主数据（只读）
# FEISHU_BITABLE_ENABLED=false
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=xxx
# FEISHU_BITABLE_APP_TOKEN=bascnxxx
# Three read-only supplier tables.
# FEISHU_SUPPLIER_MASTER_TABLE_ID=tbl_supplier_master
# FEISHU_SUPPLIER_CAPABILITY_TABLE_ID=tbl_supplier_capability
# FEISHU_SUPPLIER_CONTACT_TABLE_ID=tbl_supplier_contact
# FEISHU_SUPPLIER_ASSIGNMENT_TABLE_ID=tbl_supplier_responsibility
# 第四张表：供应商交易月度快照。开发测试数据仅允许通过显式 seed 脚本写入。
# FEISHU_BITABLE_TRANSACTION_TABLE_ID=tbl_supplier_transaction
# 明确标记交易表为正式或演示数据：real / synthetic / unknown。
# FEISHU_BITABLE_TRANSACTION_DATA_MODE=unknown
# FEISHU_BITABLE_BASE_URL=https://open.feishu.cn
# FEISHU_BITABLE_PAGE_SIZE=500
# FEISHU_BITABLE_TIMEOUT_SECONDS=10
# FEISHU_SUPPLIER_SYNC_CRON=0 */6 * * *
# 仅开发环境演示：允许商务风险 P0 使用 data_mode=synthetic 的交易快照。
# 即使设置为 true，也必须同时 DEBUG=true 才会生效。
# BUSINESS_RISK_DEMO_ENABLED=false

# 舆情监控 cron（天眼查新闻 + LLM 情感分析），默认每天10点
# SENTIMENT_CHECK_CRON=0 10 * * *

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASSWORD=change-me
MONGO_AUTH_SOURCE=admin
MONGO_DB=tianyancha

# PostgreSQL（./start.sh --dev 启动的本地基础设施）
PG_HOST=localhost
PG_PORT=5432
PG_USER=sra
PG_PASSWORD=change-me
PG_DB=sra

# JWT Authentication
# 生产环境请修改为随机字符串！
SECRET_KEY=your-secret-key-change-in-production-1234567890
# ACCESS_TOKEN_EXPIRE_MINUTES=1440  # Token 有效期（分钟），默认 24 小时

# Redis (for Celery task queue)
# REDIS_URL=redis://localhost:6379

# Transactional Outbox worker（关闭只停止消费，事件仍会原子写入）
# OUTBOX_WORKER_ENABLED=true
# OUTBOX_POLL_SECONDS=5
# OUTBOX_BATCH_SIZE=50
# OUTBOX_MAX_ATTEMPTS=8
# OUTBOX_LEASE_SECONDS=60

# Sentry (error tracking)
# SENTRY_DSN=https://your-sentry-dsn
# ENVIRONMENT=development  # or production
