# ===== MongoDB =====
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=root
# 重要：启动前必须替换以下占位符
MONGO_PASSWORD=CHANGE_ME_设置一个强密码
MONGO_AUTH_SOURCE=admin
MONGO_DB=tianyancha

# ===== Redis =====
REDIS_PASSWORD=CHANGE_ME_设置一个强密码
REDIS_URL=redis://redis:6379

# ===== PostgreSQL =====
PG_HOST=postgres
PG_PORT=5432
PG_USER=sra
PG_PASSWORD=CHANGE_ME_设置一个强密码
PG_DB=sra
PG_POOL_MIN=4
PG_POOL_MAX=20

# ===== Transactional Outbox worker =====
# 关闭只停止消费，业务事务仍会写入 Outbox 事件。
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_SECONDS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LEASE_SECONDS=60

# Agent execution role: inline (API runs Harness) or worker.
AGENT_EXECUTION_MODE=inline
AGENT_WORKER_LEASE_SECONDS=30
AGENT_WORKER_HEARTBEAT_SECONDS=5
AGENT_WORKER_POLL_SECONDS=1
AGENT_WORKER_MAX_RECOVERIES=3

# ===== Durable scheduler =====
# API 内业务 cron 默认保留以兼容现有部署。启用独立 scheduler 时改为 false，
# 并同时启动 python -m app.workers.scheduler 与 app.workers.scheduled_worker。
SCHEDULER_ROLE_ENABLED=true
SCHEDULER_MIGRATED_KINDS=
SCHEDULER_POLL_SECONDS=5
SCHEDULER_WORKER_HEARTBEAT_SECONDS=5
SCHEDULER_WORKER_LEASE_SECONDS=30
# 付费外呼默认关闭；开启前必须配置明确的操作者/服务主体与额度。
SCHEDULER_PAID_EXECUTION_ENABLED=false
SCHEDULER_SERVICE_PRINCIPALS=

# ===== JWT =====
# 重要：生成命令 python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_生成一个64位随机字符串
# 仅首次创建管理员时使用；已有用户不会重置密码。不得写入日志或提交真实值。
INITIAL_ADMIN_PASSWORD=CHANGE_ME_设置一个强密码

# ===== 付费刷新每日预算（每个计划刷新企业计 1 单位，UTC 日期） =====
PAID_REFRESH_USER_DAILY_LIMIT=50
PAID_REFRESH_GLOBAL_DAILY_LIMIT=500

# ===== Tianyancha =====
TIANYANCHA_TOKEN=CHANGE_ME_你的天眼查API令牌
TIANYANCHA_BASE_URL=https://open.api.tianyancha.com

# ===== LLM =====
LLM_API_KEY=CHANGE_ME_你的LLM_API密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Feishu =====
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# ===== Sentry =====
SENTRY_DSN=

# ===== CORS =====
CORS_ORIGINS=http://localhost

# ===== Cron =====
ALERT_CHECK_CRON=0 9 * * *
ALERT_REFRESH_CRON=0 9 * * 1
FEISHU_DIGEST_CRON=0 9 * * *
SENTIMENT_CHECK_CRON=0 10 * * *
